{
  "name": "@nexify/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23.0.0"
  },
  "scripts": {
    "dev": "node scripts/generate-public-data.mjs && vite",
    "build": "node scripts/generate-public-data.mjs && pnpm --dir ../.. lint && tsc --noEmit -p ../../tsconfig.api.json && tsc --noEmit && vite build",
    "typecheck": "node scripts/generate-public-data.mjs && tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "build:standalone": "pnpm build --mode standalone && node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.157",
    "@sentry/react": "11.9.0",
    "posthog-js": "1.438.24",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^11.9.0",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
