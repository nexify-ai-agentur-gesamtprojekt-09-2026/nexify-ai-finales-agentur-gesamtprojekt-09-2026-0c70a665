{
  "name": "@nexify/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/generate-public-data.mjs && vite",
    "build": "node scripts/generate-public-data.mjs && tsc --noEmit && vite build",
    "typecheck": "node scripts/generate-public-data.mjs && tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "build:standalone": "pnpm build && node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.157",
    "@clerk/localizations": "4.24.1",
    "@clerk/react": "6.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
