# =============================================================================
# NeXify @nexify/web — Environment-Vorlage (KEINE echten Secrets eintragen)
# -----------------------------------------------------------------------------
# Kopiere diese Datei nach apps/web/.env.local (lokal) bzw. trage die Werte als
# Projekt-Umgebungsvariablen beim Deploy-Target (Vercel) ein.
# Alle Server-Keys NUR serverseitig setzen, niemals mit NEXT_PUBLIC_-Prefix.
# Werte unten sind Platzhalter/Defaults — nichts ist erfunden oder voreingestellt.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) LLM / Router  — Pflicht für den Chat (POST /api/chat).
#    Ohne ROUTER_URL + ROUTER_KEY antwortet /api/chat mit 503 (kein Fallback).
#    Quelle der Modell-/Routing-Wahrheit: config/llm-policy.json.
# -----------------------------------------------------------------------------
# OpenAI-kompatible Basis-URL des Routers (z. B. 9router), ohne Pfad-Slash am Ende.
ROUTER_URL=
# Router-Schlüssel (Bearer).
ROUTER_KEY=
# Optional: vollständige Endpunkt-URL; überschreibt die ROUTER_URL-Ableitung.
# CHAT_COMPLETIONS_URL=
# Optional: Modell-ID; Default = Policy-Modell deepseek/deepseek-v4.1-flash-1017.
# CHAT_MODEL_ID=deepseek/deepseek-v4.1-flash-1017
#
# Zweiter Leitungsweg über das Cloudflare AI Gateway (vorbereitet, im Code GESPERRT).
# WARNUNG: Wer CHAT_LLM_ROUTE=cloudflare-ai-gateway heute setzt, schaltet den Chat für alle
# Besucher ab (503); ebenso jeder Tippfehler im Wert. Rückweg: Variable löschen, neu ausliefern.
# Freigabe erst nach D-Eintrag und nachgeführter config/llm-policy.json.
# Anleitung: docs/04-betrieb/cloudflare-ai-gateway-2026-11-14.md
# CHAT_LLM_ROUTE=
# CF_AIG_CHAT_URL=
# CF_AIG_TOKEN=
# CF_AIG_BYOK_ALIAS=

# -----------------------------------------------------------------------------
# 2) Supabase (self-hosted, OSS)  — Pflicht für Persistenz + Angebot/Bestellung.
#    Ohne diese Werte läuft der Chat weiter (persisted:false), aber
#    GET /api/offers/{id} und POST /api/offers/{id}/order antworten mit 503.
#    PostgREST muss das Schema "chat" ausliefern:  PGRST_DB_SCHEMAS="public,chat"
#    Mit der Composio-Ablage (Abschnitt 9) zusätzlich "composio":
#    PGRST_DB_SCHEMAS="public,chat,composio"
#    Optional: SUPABASE_TIMEOUT_MS = Zeitlimit je Zugriff in Millisekunden (Standard 4000, 100–15000).
# -----------------------------------------------------------------------------
# Basis-URL der Supabase-/PostgREST-Instanz (z. B. https://db.nexifyai.cloud).
SUPABASE_URL=
# Service-Role-JWT (umgeht RLS) — NUR serverseitig, nie im Client.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 3) Resend (Mailing)  — für die Bestell-/Rechnungs-Mail (lib/mailing.ts).
#    Ohne Konfiguration wird der Versand sauber übersprungen (mailSkipped:true),
#    die Bestellung bleibt gültig. Absender-Domain laut config/integrations/resend.json:
#    nexifyai.cloud (verifiziert), Absenderadresse angebot@nexifyai.cloud.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Vollständiger Absender inkl. Anzeigename, z. B. "NeXify AI <angebot@nexifyai.cloud>".
RESEND_FROM=
# Fallback-Adresse, falls RESEND_FROM nur die Adresse ohne Anzeigename ist.
RESEND_FROM_ADDRESS=angebot@nexifyai.cloud

# -----------------------------------------------------------------------------
# 4) Externes Fulfilment (optional)  — Außenversand der Bestellung (chat-store.ts).
#    Nur setzen, wenn eine Bestellung an ein externes System weitergereicht wird.
#    Nicht gesetzt = Bestellung bleibt im Status "placed" (kein Dispatch).
# -----------------------------------------------------------------------------
# ORDER_DISPATCH_URL=
# ORDER_DISPATCH_TOKEN=

# -----------------------------------------------------------------------------
# 5) Clerk Auth  — für geschützte Bereiche (/intern, /teileklar/admin, Registrierung).
#    Für den öffentlichen Chat→Angebot→Bestellung-Fluss NICHT erforderlich.
# -----------------------------------------------------------------------------
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_DOMAIN=clerk.nexifyai.de
# NEXT_PUBLIC_CLERK_PROXY_URL=
# NEXT_PUBLIC_CLERK_IS_SATELLITE=
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# NEXT_PUBLIC_CLERK_CHECKOUT_CONTINUE_URL=

# -----------------------------------------------------------------------------
# 6) Observability (optional, empfohlen).
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# 7) Managed Live-Chat / Agent-Gateway (optional, SEPARATE Route /api/agent-chat).
#    Steuert den öffentlichen Orientierungs-Chat (packages/agent-runtime), NICHT
#    den /api/chat → Angebot → Bestellung-Fluss. Standard: ausgeschaltet.
# -----------------------------------------------------------------------------
# NEXIFY_LIVE_CHAT=
# AI_GATEWAY_API_KEY=
# NEXIFY_AI_GATEWAY_CREDITS_PROBE=

# -----------------------------------------------------------------------------
# 8) Revolut  — NUR für das separate Prepaid-/API-Billing (config/api-prepaid.json),
#    NICHT Teil des Chat→Angebot→Bestellung-Flusses und von apps/web NICHT gelesen.
#    Hier nur dokumentiert, weil der Go-live-Umfang es erwähnt; der zugehörige
#    Zahlungs-Worker ist noch nicht gebaut. Endpunkt/Version vor dem Bau gegen die
#    aktuelle Revolut-Doku bestätigen (siehe config/api-prepaid.json).
# -----------------------------------------------------------------------------
# REVOLUT_API_BASE=https://merchant.revolut.com/api      # Sandbox: https://sandbox-merchant.revolut.com/api
# REVOLUT_API_VERSION=                                    # Header "Revolut-Api-Version"
# REVOLUT_MERCHANT_SECRET_KEY=
# REVOLUT_WEBHOOK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# 9) Composio-Webhook (POST /webhook/v1 und /api/webhook/v1)  — Empfang und dauerhafte Ablage.
#    Ablage: dieselbe Supabase-Instanz wie in Abschnitt 2 (SUPABASE_URL,
#    SUPABASE_SERVICE_ROLE_KEY), eigenes Schema "composio". Keine weiteren Variablen.
#    Voraussetzung auf der Datenbank, VOR dem Ausliefern dieser Fassung:
#      1. apps/web/supabase/migrations/0004_composio.sql einspielen
#      2. PGRST_DB_SCHEMAS="public,chat,composio" setzen und PostgREST neu laden
#    Sind die Supabase-Variablen gesetzt, aber Migration oder Schema fehlen, antwortet der
#    Webhook auf gültige Ereignisse mit 500 (Composio stellt erneut zu).
#    Ohne Supabase-Variablen: Ablage nur im Arbeitsspeicher einer Funktionsinstanz, nicht dauerhaft.
#    Details: GO-LIVE.md, Abschnitt "Composio-Webhook: dauerhafte Ablage".
# -----------------------------------------------------------------------------
# Nur der exakte Wert "on" schaltet den Empfang ein.
# NEXIFY_COMPOSIO_WEBHOOK=on
# Signaturschlüssel des Webhooks aus dem Composio-Dashboard — NUR serverseitig.
# COMPOSIO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Indexierung (Suchmaschinen)  — Standard: gesperrt. NUR der Inhaber setzt diese Werte,
#    und nur in der Vercel-Umgebung "Production" (docs/04-betrieb/indexierung-freigabe-2026-11-14.md).
#    Regel: apps/web/auth/indexing.ts (Schalter + Produktion + freigegebene Domain + Seitenliste).
# -----------------------------------------------------------------------------
# NEXIFY_INDEXING=enabled
# Zusätzlich für /teileklar, erst wenn der Shop-Dienst antwortet:
# NEXIFY_INDEXING_TEILEKLAR=enabled


# -----------------------------------------------------------------------------
# 10) Einwilligungsweg für Werbemails (POST /api/mailing/subscribe, /confirm, /unsubscribe)
#    Standard: AUS. Anmeldung mit Bestätigungsmail, Nachweis und Sperrliste (apps/web/mailing/).
#    Die Anmeldung arbeitet erst, wenn zusätzlich die Freigaben des Inhabers in
#    config/integrations/mailing-consent.json stehen, Migration 0005 eingespielt ist
#    (PGRST_DB_SCHEMAS="public,chat,composio,mailing") und Supabase (2) sowie Resend (3) gesetzt sind.
#    Fehlt etwas: 503, kein Versand. Die Abmeldung hängt nicht am Schalter.
#    Reihenfolge und Rückweg: docs/04-betrieb/einwilligungsweg-2026-11-14.md
# -----------------------------------------------------------------------------
# Nur der exakte Wert "on" schaltet die Anmeldung ein.
# NEXIFY_MAILING_CONSENT=on
# Öffentliche Adresse der Website für Links in Mails: nur https, nur Ursprung, ohne Pfad.
# MAILING_PUBLIC_BASE_URL=
