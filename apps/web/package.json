{
  "name": "@nexify/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23.0.0"
  },
  "scripts": {
    "dev": "node scripts/generate-public-data.mjs && next dev --hostname 127.0.0.1 --port 3004",
    "build": "node scripts/generate-public-data.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 3004",
    "typecheck": "node scripts/generate-public-data.mjs && tsc --noEmit",
    "test:auth": "node --test auth/tests/*.test.mjs",
    "cf:build": "node scripts/generate-public-data.mjs && opennextjs-cloudflare build",
    "cf:preview": "wrangler dev --ip 127.0.0.1 --port 8799",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@sentry/nextjs": "11.9.0",
    "next": "16.4.3",
    "posthog-js": "1.438.24",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "^4.161.0"
  }
}
