{
  "schema_version": 1,
  "app_root": "apps/site",
  "entry": "apps/site/src/main.tsx",
  "shell": "apps/web/components/Workspace.tsx",
  "output": "apps/site/dist",
  "deployment_config": "vercel.json",
  "public_routes": "config/site-map.json",
  "tokens": "config/design-tokens.json",
  "locales": [
    "de",
    "nl",
    "fr",
    "en"
  ],
  "modules": {
    "agency": {
      "public": true,
      "business_backend": "not_connected"
    },
    "selfservice": {
      "public": true,
      "business_backend": "apps/selfservice/domain.py"
    },
    "customer": {
      "public": false,
      "business_backend": "blocked_pending_verified_identity"
    },
    "local_control": {
      "public": false,
      "business_backend": "tools/app_backend.py"
    },
    "teileklar_shop": {
      "public": true,
      "business_backend": "apps/agent-gateway/server.py",
      "local_http_contract_version": "local-shop-http-1",
      "integration_status": "local_http_ui_tested_with_isolated_fixtures",
      "production_catalog_connected": false,
      "order_submission_enabled": false,
      "payment_enabled": false,
      "authorization": "existing_guest_session_plus_object_capability; server_resolved_tenant; no_customer_role_grant",
      "current_backend_source": "apps/shop-api/shop",
      "backend_source_note": "FastAPI/Mongo implementation exists; historical local fixture contract below is retained, not a production binding."
    }
  },
  "session_contract": {
    "version": "local-app-session-1",
    "provider_auth_enabled_by_this_contract": false,
    "browser_claims_authorize_backend": false,
    "local_operator_adapter_only": true,
    "production_identity_adapter": "not_verified",
    "roles": {
      "operator": [
        "probe",
        "submit",
        "run-once",
        "status",
        "resume",
        "refresh-review"
      ],
      "reviewer": [
        "status",
        "review"
      ]
    }
  },
  "canonical_production_domain": null,
  "production_runtime_verified": false,
  "leading_working_surface": "config/deployment-topology.json#working_authority"
}
