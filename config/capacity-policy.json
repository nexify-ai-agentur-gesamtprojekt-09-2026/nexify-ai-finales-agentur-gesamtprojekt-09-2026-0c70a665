{
  "schema_version": 1,
  "scope": "canonical_agency_project",
  "mode": "offline_audit_only",
  "max_input_bytes": 262144,
  "max_hosts": 32,
  "max_workloads": 128,
  "max_scenarios": 16,
  "required_headroom_fraction": 0.25,
  "measurement_max_age_days": 30,
