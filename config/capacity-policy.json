  "boundaries": {
    "no_process_control": true,
    "no_deploy_or_placement_approval": true,
    "no_network_or_load_generation": true,
    "no_remote_host_inventory_claim": true,
    "unknown_measurements_prevent_readiness": true,
    "vendor_llm_not_charged_to_host_model_ram": true,
    "headroom_is_planning_assumption_not_measured_redundancy": true
  }
}
