{
  "schema_version": 1,
  "scope": "canonical_agency_project",
  "default_database": ".local/remediation/queue.sqlite3",
  "max_items": 2000,
  "max_history_records": 20000,
  "max_source_bytes": 524288,
  "max_source_refs": 32,
  "default_due_seconds": 3600,
  "retry_delays_seconds": [
    60,
    300,
    1800
  ],
  "max_attempts": 3,
  "escalation_owner": "D01",
  "verifiers": [
    "local_file_sha256",
    "project_skills_integrity",
    "managed_llm_policy",
    "external_readback_required",
    "context_reader_regression",
    "brain_ingestion_regression",
    "seo_atomicity_regression",
    "browser_evidence_binding",
    "local_control_prerequisites"
  ],
  "boundaries": {
    "local_operator_registry_not_authenticated_customer_api": true,
    "no_arbitrary_commands": true,
    "no_network_or_paid_calls": true,
    "no_approval_or_authorization_bypass": true,
    "external_receipt_or_boolean_alone_cannot_resolve": true,
    "native_check_must_match_current_scope_and_source_fingerprint": true,
    "scheduler_or_external_notification_installed": false,
    "operational_defaults_are_not_customer_sla": true,
    "does_not_stop_existing_processes_or_disable_unmigrated_customer_flows": true,
    "migration_readiness_is_not_runtime_disabling": true
  }
}
