{
  "$kommentar": "Langlauf-Regeln. Umgesetzt in lib/langlauf.js (32/32 Prüffälle). Stand 27.09.2026.",
  "lauf": {
    "maxStunden": 72,
    "budgetCentStandard": 200,
    "budgetCentMax": 5000,
    "checkpoint": "nach jedem Schritt und alle 5 Minuten während eines Schritts",
    "speicher": "Postgres (laeufe, schritte, ereignisse); Artefakte im Objektspeicher, im Zustand nur Referenz",
    "lease": {
      "ttlSek": 900,
      "pulsSek": 60
    },
    "ende": [
      "fertig",
      "abgebrochen"
    ],
    "nieEndlos": "Jeder Lauf endet in genau einem Endzustand oder wartet sichtbar auf einen Menschen",
    "leasePflicht": true,
    "schemaFehler": "Schritt gesperrt, Lauf wartet auf Freigabe durch Pascal",
    "budgetErhoehen": "nur Pascal, höchstens budgetCentMax"
  },
  "pipeline": [
    {
      "id": "wissen",
      "agent": "sammler",
      "parallel": true,
      "quellen": [
        "LightRAG",
        "docs/**/*.md",
        "Chats",
        "Dateien",
        "AgentMemory"
      ],
      "ausgabe": "Wissensakte mit Fundstellen"
    },
    {
      "id": "recherche",
      "agent": "rechercheur",
      "parallel": true,
      "tiefe": {
        "ebenen": 3,
        "primaerquellenMin": 8,
        "maxAlterTage": 30,
        "quellenArt": [
          "Hersteller-Doku",
          "Normen/Recht",
          "Repos",
          "Fachartikel"
        ]
      },
      "ausgabe": "Bestpraxis-Akte mit Datum und Quelle je Aussage"
    },
    {
      "id": "profil",
      "agent": "analyst",
      "braucht": [
        "wissen",
        "recherche"
      ],
      "ausgabe": "Anforderungsprofil (Vorlage docs/01-konzept/anforderungsprofil-vorlage.md)"
    },
    {
      "id": "vergleich",
      "agent": "architekt",
      "braucht": [
        "profil"
      ],
      "regel": "je Anforderung ≥ 3 Lösungen, bewertet nach Profil-Kriterien, übernommene Muster benannt",
      "ausgabe": "Vergleichsmatrix"
    },
    {
      "id": "loesung",
      "agent": "director",
      "braucht": [
        "vergleich"
      ],
      "ausgabe": "Gesamtlösung: WebUI-Entwurf, Umsetzungsplan, Tests, Gate-Plan",
      "mensch": "Freigabe Umsetzung durch Pascal"
    }
  ],
  "sperren": [
    "Endabnahme nur Pascal",
    "Hartsperren Reboot/DNS/Firewall",
    "Preise, Rechte, Rechtstexte nie automatisch ändern"
  ]
}
