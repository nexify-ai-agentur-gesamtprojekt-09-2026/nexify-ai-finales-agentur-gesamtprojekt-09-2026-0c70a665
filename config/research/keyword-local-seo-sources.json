  "findings": [
    {
      "id": "estimated-not-exact",
      "source_ids": [
        "google-metrics-type",
        "google-monthly-type",
        "google-keyword-help"
      ],
      "finding": "Monthly volumes are approximate and rounded; a null monthly_searches is unavailable, not zero. avg_monthly_searches is a twelve-month average, not a specific calendar month."
    },
    {
      "id": "variant-groups",
      "source_ids": [
        "google-request-type",
        "google-historical-guide"
      ],
      "finding": "Near-exact deduplication can omit requested inputs; preserve response text + close_variants; never sum variants as disjoint traffic."
    },
    {
      "id": "explicit-targeting",
      "source_ids": [
        "google-request-type"
      ],
      "finding": "Maximum10000 keywords and10 geo targets per request; empty geography may mean global, unset network defaults Google Search And Partners, unset language includes all keywords."
    },
    {
      "id": "historical-window",
      "source_ids": [
        "google-historical-options"
      ],
      "finding": "Default past12months; up to past4years may be requested; only available subset may return. Store requested and actual months."
    },
    {
      "id": "access-doc-drift",
      "source_ids": [
        "google-access-token",
        "google-auth"
      ],
      "finding": "Developer-token page describes September9,2026 transfer of access levels to Cloud projects and API Center deprecation; OAuth page still says developer token required. Do not create an account or assume a new-manager-token workflow from older guidance."
    },
    {
      "id": "local-page-policy",
      "source_ids": [
        "google-spam-policies"
      ],
      "finding": "City/regional doorway funnels and scaled low-value pages violate Google policy; imported locality records are not publication authorization."
    },
    {
      "id": "rendering",
      "source_ids": [
        "google-js-seo",
        "vercel-vite",
        "vercel-vite-nitro"
      ],
      "finding": "Google renders JS but recommends server-side/prerendered content. SPA rewrite to index.html solves deep links, not per-URL SEO HTML; Vercel recommends production Multi-Page App and documents Nitro SSR/prerendering."
    },
    {
      "id": "truthful-schema",
