  "proposed_pipeline": [
    {
      "step": 1,
      "name": "Freeze product/service candidates and approved markets",
      "gate": "No legally_active=true inferred from dataset membership or B.V. domicile."
    },
    {
      "step": 2,
      "name": "Snapshot locality sources with checksum/license/version and declared unit",
      "gate": "Import into draft catalog only; preserve authority IDs, admin hierarchy, aliases/languages, validity/status, attribution. Verify total/pagination and unit filters before any completeness claim."
    },
    {
      "step": 3,
      "name": "Prepare unranked seed/secondary terms from actual approved product catalog",
      "gate": "Separate agency,NeX2fly,TEILEKLAR and workshop intents. City-in-query vs searcher geography are separate dimensions. No invented Top10."
    },
    {
      "step": 4,
      "name": "Read authorized historical metrics with fixed comparable targeting",
      "gate": "Explicit country/city geo, language, GOOGLE_SEARCH network, calendar month range; batches with response/input reconciliation, close-variant groups and nulls. No global default; no account or billing creation."
    },
    {
      "step": 5,
      "name": "Create reviewable top10 plus secondary groups",
      "gate": "Rank only available comparable data with business fit, intent, overlap, freshness; report monthly estimates separately from average and advertiser competition. No false exactness or city-national sums."
    },
    {
      "step": 6,
      "name": "Decide local page value and rendering architecture",
      "gate": "A locality entry does not create a landing page. Require approved actual service area and distinct local user value; no fake local offices, fabricated evidence or duplicate doorway funnels. SSG/prerender public content, preserve existing private auth boundaries."
    },
    {
      "step": 7,
      "name": "Validate draft before publication",
      "gate": "Source/claim review, per-URL HTML/title/canonical/hreflang/status/schema, mobile/accessibility, noindex draft and approved-only sitemap; no automatic publication/indexing in research."
    }
  ],
