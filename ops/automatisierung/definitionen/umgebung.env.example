# Namen der Variablen für die Automatisierungen. Diese Datei enthält keine Werte und wird nicht geladen.
# Werte gehören in den Geheimnisspeicher des Ortes, an dem die Automatisierung läuft
# (Umgebungsdatei auf dem Server mit Rechten 600, Hermes-Umgebung, Umgebung der geplanten Aufgabe).

# Schalter je Automatisierung: nur der genaue Wert `ein` schaltet ein. Zusätzlich muss `aktiv` in
# config/prozess-automatisierung.json auf true stehen.
NEXIFY_AUTO_TAGESBERICHT=
NEXIFY_AUTO_WAECHTER=
NEXIFY_AUTO_ANFRAGEN=
NEXIFY_AUTO_FRISTEN=

# Notaus: jeder nicht leere Wert schaltet alle Automatisierungen sofort ab.
NEXIFY_AUTO_NOTAUS=

# Dauerhafter Ordner für Buch, Protokoll, Fehlerliste und Meldungen (Vorgabe: .local/automatisierung im Repository).
NEXIFY_AUTO_ZUSTAND=

# Mail an die interne Adresse (eigener Schalter; zusätzlich `zustellung.resend_intern.aktiv` in der Konfiguration).
NEXIFY_AUTO_MAIL_INTERN=
NEXIFY_AUTO_INTERN_AN=
RESEND_FROM=
RESEND_API_KEY=
