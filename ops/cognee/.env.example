# NeXify · Variablennamen für den Cognee-Adapter (ops/cognee). Keine Werte in dieser Datei.
# Werte trägt der Inhaber im Geheimnisspeicher der jeweiligen Laufzeit ein; nichts davon gehört ins Repository.
# Ohne diese Variablen sendet der Adapter nichts.

# Hauptschalter. Nur der Wert 1 schaltet ein.
COGNEE_ENABLED=
# Zusätzlicher Schalter für die Aufnahme (ops/cognee/aufnahme.py senden). Nur der Wert 1 schaltet ein.
COGNEE_INGEST_ENABLED=
# Zusätzlicher Schalter für den Graphbau (löst Modellkosten auf der Instanz aus). Nur der Wert 1 schaltet ein.
COGNEE_COGNIFY_ENABLED=
# https-Adresse der Instanz ohne Pfad; der Host muss in config/integrations/cognee.json freigegeben sein.
COGNEE_BASE_URL=
# Mandant dieser Laufzeit; in diesem Repository ist nur nexify-agentur zugelassen.
COGNEE_TENANT=
# Rolle dieser Laufzeit: aufnahme, lesen-claude oder lesen-hermes.
COGNEE_ROLE=
# api_key (Standard) oder proxy (der Proxy der Claude-Umgebung setzt den Kopf X-Api-Key ein).
COGNEE_AUTH_MODE=
# Nur bei api_key: Dienstschlüssel der Rolle (Kopf X-Api-Key). Wert nur im Geheimnisspeicher.
COGNEE_API_KEY=
