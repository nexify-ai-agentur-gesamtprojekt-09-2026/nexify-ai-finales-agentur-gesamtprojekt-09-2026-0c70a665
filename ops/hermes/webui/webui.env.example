# NeXify · Variablennamen für die Hermes-Oberfläche (nesquena/hermes-webui, geprüft an v0.52.492).
# Keine Geheimnisse in dieser Datei. Die Werte unten sind nicht geheim und gehören in die
# Umgebung des Dienstes, der die Oberfläche startet (Compose `environment` oder die .env,
# die der Startweg der vorgefundenen Installation liest; das ist in Schritt 0 festzustellen).

# Ordner mit dem Graphite-Skin, wie er IM Container sichtbar ist (nur lesend eingehängt,
# siehe ops/hermes/docker/docker-compose.nexify.yml). Muss vor dem Start vorhanden sein.
HERMES_WEBUI_EXTENSION_DIR=/opt/nexify/hermes-webui-ext
HERMES_WEBUI_EXTENSION_MANIFEST=extensions.json

# Name des Assistenten in Titel, Kopfzeile und Anmeldeseite. Am 14.11.2026 stand auf der
# Anmeldeseite von unternehmensbot.eu „NeX Agentic AI“; ein Wert in den Einstellungen der
# Oberfläche (settings.json) geht dieser Variable vor.
HERMES_WEBUI_BOT_NAME=NeX

# Nur an die lokale Schleife binden, sobald der Zugang über Tunnel oder privates Netz steht
# (Wege A, B, D der Betriebsnotiz). Heute lauscht die Instanz auf srv1941843 auf 0.0.0.0.
HERMES_WEBUI_HOST=127.0.0.1

# NICHT setzen: HERMES_WEBUI_DEFAULT_MODEL (übersteuert das Modell an config/llm-policy.json vorbei).
# Geheim und deshalb nie hier: HERMES_WEBUI_PASSWORD (trägt nur der Inhaber ein).
