# NeXify · Variablennamen für /root/.hermes/.env (Rechte 600). Keine Werte in dieser Datei.
# Werte trägt der Inhaber auf dem Server ein; nichts davon gehört ins Repository.

# Schlüssel für OpenRouter (einziger Modellanbieter laut config/llm-policy.json).
OPENROUTER_API_KEY=

# Absoluter Pfad des Monorepo-Checkouts, wie er IM Container sichtbar ist
# (wird in config.yaml für terminal.cwd und skills.external_dirs eingesetzt).
NEXIFY_REPO=

# Nicht setzen (prüft ops/hermes/einspielen.sh): HERMES_INFERENCE_MODEL,
# HERMES_YOLO_MODE sowie Schlüssel weiterer Modellanbieter.
