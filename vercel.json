{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "work/v3r2-p26-local-files": false
    }
  },
  "services": {
    "frontend": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
      "buildCommand": "pnpm --filter @nexify/web build",
      "functions": {
        "app/api/agent-chat/route.ts": {
          "maxDuration": 10,
          "regions": [
            "fra1"
          ]
        },
        "app/api/agent-runtime-status/route.ts": {
          "maxDuration": 15,
          "regions": [
            "fra1"
          ]
        }
      }
    },
    "shop": {
      "root": "apps/shop-api",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app",
      "functions": {
        "vercel_app.py": {
          "maxDuration": 30,
          "regions": [
            "fra1"
          ],
          "includeFiles": "vercel_support/bigbuy_get.py"
        }
      },
      "buildCommand": "python3 prepare_vercel.py"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://clerk.nexifyai.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://eu.i.posthog.com https://*.ingest.de.sentry.io https://clerk.nexifyai.de; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/shop/:path*",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/auth/:path*",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/admin/:path*",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/workshops/:path*",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/requests/:path*",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/health",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/openapi.json",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/docs",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/api/docs/:path*",
      "destination": {
        "service": "shop"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
