{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @nexify/site build",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "outputDirectory": "apps/site/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://clerk.nexifyai.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://eu.i.posthog.com https://*.ingest.de.sentry.io https://clerk.nexifyai.de; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; report-uri https://eu.i.posthog.com/report/?token=phc_qNJhLzhtRHnNuCKw5zywcGcgxzyYki52iTaKkutc6rPh&v=1; report-to csp"
        },
        {
          "key": "Report-To",
          "value": "{\"group\":\"csp\",\"max_age\":10886400,\"endpoints\":[{\"url\":\"https://eu.i.posthog.com/report/?token=phc_qNJhLzhtRHnNuCKw5zywcGcgxzyYki52iTaKkutc6rPh&v=1\"}]}"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|\\.well-known(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/agent-chat.ts": {
      "maxDuration": 10,
      "regions": [
        "fra1"
      ]
    },
    "api/agent-runtime-status.ts": {
      "maxDuration": 15,
      "regions": [
        "fra1"
      ]
    }
  }
}
