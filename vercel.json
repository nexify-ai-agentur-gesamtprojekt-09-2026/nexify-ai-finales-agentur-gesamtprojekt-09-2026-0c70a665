{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @nexify/site build",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "outputDirectory": "apps/site/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|\\.well-known(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/agent-chat.ts": {
      "maxDuration": 10,
      "regions": [
        "fra1"
      ]
    },
    "api/agent-runtime-status.ts": {
      "maxDuration": 15,
      "regions": [
        "fra1"
      ]
    }
  }
}
