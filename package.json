{
  "name": "@nexify/factory",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "pnpm --filter @nexify/web dev",
    "dev:gateway": "python3 apps/agent-gateway/server.py --database .local/visitor.sqlite --port 3003 --web-origin http://127.0.0.1:3004",
    "preview:references": "node server.mjs",
    "build": "pnpm --filter @nexify/web build",
    "typecheck": "pnpm --filter @nexify/web typecheck",
    "verify": "make check && make test && make check-arch"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  }
}
