{
  "name": "nexify-myadmin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.0",
  "description": "NeXify AI Gesamtloesung — Monorepo-Wurzel (Web-App, Tokens, UI, Tools, Infra).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node tools/ds-audit-cli.js",
    "test": "node tools/selbsttest.mjs && node --test tools/*.test.js",
    "build": "npm --workspace @nexify/web run build",
    "dev": "npm --workspace @nexify/web run dev",
    "e2e": "bash scripts/e2e.sh",
    "ci:kette": "turbo run check test build",
    "ci:kette:dry": "turbo run check test build --dry=json"
  },
  "devDependencies": {
    "turbo": "2.11.9"
  },
  "engines": {
    "node": ">=22"
  }
}
