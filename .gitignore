# Betriebsgeheimnisse und lokale Ablage nie versionieren
.env
*.pem
*.key
secrets/

# Node-/Toolchain-Artefakte
node_modules/
__pycache__/
.venv/

# Betriebssystem
.DS_Store
Thumbs.db

# Logs
*.log

# Lokale Harness-Ausfuehrungsspuren und kooperativer Verifikationslock
.harness/traces/
.harness/feature-verification.lock

.gitlab-ci-local/

.next/

apps/web/node_modules/

apps/web/.next/

apps/web/tsconfig.tsbuildinfo

# Monorepo local state and secrets
.local/
.env*
!.env.example

# Explicitly supplied PUBLIC verification material; private keys remain ignored.
!config/public-keys/clerk-provided.pem

# Portable public React build outputs; source and release tools remain tracked.
apps/site/dist/
apps/site/.generated/
apps/web/.generated/
apps/site/standalone.html
.vercel

# Local Vercel linking/OIDC and installed agent guidance are not app artifacts.
.vercel/
.agents/skills/
.codex/skills/
.env.*
*.env
credentials.json
.credentials

# Deployment env templates carry no secrets and stay tracked;
# real .env / .env.* / *.env files remain ignored by the rules above.
!.env.example
!apps/web/.env.example

# local secrets / caches (Phase 1)
memory/test_credentials.md
apps/shop-api/data/

# Sites static publication output
/dist/

# Cloudflare Workers (OpenNext) Build-Ausgaben
apps/web/.open-next/
apps/web/.wrangler/

# Graphify-Wissensgraph: wird lokal mit tools/graph.sh erzeugt, nicht versioniert (rund 14 MB je Stand)
graphify-out/

# Lokale Worker-Variablen (wrangler dev); Muster: apps/web/.dev.vars.example
apps/web/.dev.vars
