index 1cb11bd..de65aca 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -28,11 +28,25 @@ python-tests:
   script:
     - python3 -m unittest discover -s tests -p "test_github_event_inbox.py" -q
 
-# Preview-Testharness benoetigt Node fuer den echten Server. Das gepruefte
-# Node-Image bringt auch Python3 fuer das Standardbibliothek-Harness mit.
+# Python 3.12 + Node 22 in one hermetic job. The previous node image only had
+# Python 3.11, so the pinned Pillow 12.3.0 wheels and generated public data
+# were unavailable. This keeps CI aligned with the local/GitHub runtime.
+.ci-python312-node22: &ci-python312-node22
+  image: python:3.12-bookworm
+  before_script:
+    - apt-get update
+    - apt-get install -y --no-install-recommends ca-certificates curl git xz-utils
+    - curl -fsSL https://nodejs.org/dist/v22.23.4/node-v22.23.4-linux-x64.tar.xz -o /tmp/node.tar.xz
+    - tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1
+    - node --version
+    - "python3 -m pip install --only-binary=:all: --no-deps --require-hashes --requirement requirements-image.txt"
+    - npm install --global --ignore-scripts pnpm@12.15.0
+    - pnpm install --frozen-lockfile --ignore-scripts
+    - node apps/site/scripts/generate-public-data.mjs
+
 runtime-tests:
+  <<: *ci-python312-node22
   stage: pruefen
-  image: node:22-bookworm@sha256:63538dfe497cc29dfafdda25ada09b46db68a3f4cc205abf1f5d6bf0913f3384
   script:
     - node --test tests/gesundheit.test.mjs
     - python3 -m unittest discover -s tests -q
@@ -47,8 +61,8 @@ node-syntax:
       exit $fail
 
 arch-regeln:
