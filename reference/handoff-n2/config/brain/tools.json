{
  "$kommentar": "Tool-Register + Tool-Orakel · Soll · Entwurf 29.09.2026",
  "risikoklassen": {
    "A": { "beschreibung": "lesend, intern", "freigabe": "automatisch nach Tests" },
    "B": { "beschreibung": "schreibend, intern (Dateien, Entwürfe)", "freigabe": "1 Mensch" },
    "C": { "beschreibung": "extern, Geld, Löschen, Nachrichten an Dritte", "freigabe": "Mensch + 2. Faktor", "immer_rueckfrage": true }
  },
  "orakel": {
    "schritte": ["bedarf", "entwurf_schema", "code_tests_zuerst", "pruefung", "simulation", "freigabe", "registrierung", "betrieb"],
    "simulation": { "pruefFaelle": 20, "gegenFaelle": ["negativ", "grenzwert", "missbrauch"] },
    "selbstfreigabe": false,
    "rueckzug": { "schalter": true, "automatisch_ab_fehlerrate": 0.05 }
  },
  "werkzeuge": [
    { "id": "wissen.lesen",     "klasse": "A", "eingabe": { "frage": "string", "markt": "string?" }, "ausgabe": { "treffer": "array", "fundstelle": "string" }, "limit": "60/min" },
    { "id": "preisliste.lesen", "klasse": "A", "quelle": "config/fakten.json", "limit": "120/min" },
    { "id": "kalender.slots",   "klasse": "A", "eingabe": { "tag": "date", "leistung": "string" }, "limit": "30/min" },
    { "id": "rechenkern.cent",  "klasse": "A", "beschreibung": "Summen, USt., Rundung je Position in ganzen Cent", "test": "tools/nexify-preis.test.js" },
    { "id": "dateien",          "klasse": "B", "wurzel": "projektordner", "rueckfrage": true },
    { "id": "git",              "klasse": "B", "verboten": ["push --force"], "rueckfrage": true },
    { "id": "browser",          "klasse": "A", "nur_lesend": true },
    { "id": "tests",            "klasse": "A" },
    { "id": "mail.lesen",       "klasse": "A", "mandantengetrennt": true },
    { "id": "mail.senden",      "klasse": "C", "immer_rueckfrage": true },
    { "id": "zahlung.ausloesen","klasse": "C", "gesperrt_bis": "Freigabe durch Pascal" }
  ]
}
