    { "schritt": "speichern",   "ziel": ["vektor", "volltext"] },
    { "schritt": "pruefen",     "testfragenJeQuelle": 20, "fundstellenTreffer": 0.9 },
    { "schritt": "freigeben",   "durch": "mensch bei Preisen und Recht" }
  ],
  "antwortregel": { "fundstelle": "pflicht", "kein_treffer": "weiss ich nicht + uebergabe" },
  "pflege": {
    "taeglich":    { "uhr": "03:00", "aufgaben": ["neue_quellen", "abgelaufene_sperren", "widersprueche_melden"] },
    "woechentlich":{ "regressionstest": true, "abfallSchwelle": 2, "rollback": true },
    "monatlich":   { "lora_vorschlag": true, "nur_freigegebene_daten": true, "uebernahme_wenn": "testguete >= vorher" }
  },
  "waechter": { "gegentest": true, "meldung_nur_bei_neu": true, "zustellung_bestaetigt": true, "kette": "bestehende Alarmkette an Pascal" }
