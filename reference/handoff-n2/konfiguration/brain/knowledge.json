    { "id": "pruefkataloge","pfad": "docs/paket/", "vertrauen": "hoch" },
    { "id": "rechtstexte", "pfad": "Rechtliches.dc.html", "vertrauen": "hoch", "gueltigBis": "Fassung+12 Monate" },
    { "id": "runbooks",    "pfad": "docs/04-betrieb/", "vertrauen": "hoch" },
    { "id": "kundendokumente", "pfad": "mandant/{tenant}/", "vertrauen": "kundenseitig", "getrennt": true, "training": false }
  ],
  "pipeline": [
    { "schritt": "erfassen",    "felder": ["quelle", "version", "datum", "rechte"] },
    { "schritt": "bereinigen",  "regeln": ["keine_geheimnisse", "pii_filter", "tabellen_erhalten"] },
    { "schritt": "segmentieren","tokens": [300, 800], "pfad": "ueberschriften" },
    { "schritt": "anreichern",  "felder": ["titel", "quelle", "gueltigAb", "sprache", "markt", "vertrauen"] },
