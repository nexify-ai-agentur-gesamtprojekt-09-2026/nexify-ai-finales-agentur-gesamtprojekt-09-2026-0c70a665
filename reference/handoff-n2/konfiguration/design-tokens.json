{
  "$description": "NeXify Designsystem 'Graphit & Lime' · einzige Token-Quelle · Fassung 2.0 (= NeXifyAI Cloud v12) · W3C-DTCG-Format",
  "color": {
    "graphit": { "900": { "$value": "#1B1E1D", "$type": "color" }, "850": { "$value": "#1E2220", "$type": "color", "$description": "eingelassene Flächen (Well)" }, "800": { "$value": "#242826", "$type": "color", "$description": "Seitengrund" }, "700": { "$value": "#2A2E2C", "$type": "color" }, "650": { "$value": "#262A28", "$type": "color", "$description": "Karte unten" }, "600": { "$value": "#303634", "$type": "color", "$description": "Karte oben" } },
    "linie": { "fein": { "$value": "rgba(255,255,255,.08)", "$type": "color" }, "mittel": { "$value": "#363A38", "$type": "color" }, "stark": { "$value": "#4A4F4C", "$type": "color" } },
    "text": { "primaer": { "$value": "#FFFFFF", "$type": "color" }, "sekundaer": { "$value": "#E3E6E3", "$type": "color" }, "tertiaer": { "$value": "#BCC1BD", "$type": "color" }, "gedaempft": { "$value": "#9CA29E", "$type": "color", "$description": "5,9:1 auf graphit-800" }, "aufLime": { "$value": "#111312", "$type": "color" } },
    "marke": { "lime": { "$value": "#D7FA50", "$type": "color" }, "limeHell": { "$value": "#EEFF9A", "$type": "color" }, "limeDunkel": { "$value": "#BFE83C", "$type": "color" }, "limeGruen": { "$value": "#78C331", "$type": "color" } },
    "semantik": { "erfolg": { "$value": "#6FE3CF", "$type": "color" }, "warnung": { "$value": "#FFC24A", "$type": "color" }, "fehler": { "$value": "#FF8A7A", "$type": "color" }, "licht": { "$value": "#A78BFA", "$type": "color", "$description": "nur Signalfeld und Lichtflecken" } },
    "print": { "tinte": { "$value": "#14191C", "$type": "color" }, "papier": { "$value": "#F2F3EF", "$type": "color" }, "lime": { "$value": "#C8F04B", "$type": "color", "$description": "Lime für Papier und E-Mail (CD-2026); auf Bildschirm immer marke.lime" }, "grau": { "$value": "#646769", "$type": "color" } }
  },
  "font": { "text": { "$value": "Geist, Helvetica, Arial, sans-serif", "$type": "fontFamily" }, "mono": { "$value": "'Geist Mono', ui-monospace, monospace", "$type": "fontFamily" } },
  "type": { "h1": "80/0.98/-0.04em (mobil 38–52)", "h2": "42–52/1.05/-0.03em", "h3": "20–28/1.15/-0.02em", "body": "17–18/1.55", "small": "13–15/1.5", "kicker": "Mono 12–14" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "radius": { "klein": "8px", "button": "10px", "chip": "12px", "karte": "16px", "leit": "20px", "pille": "999px" },
  "breakpoint": { "s": "640px", "m": "820px", "l": "1040px", "xl": "1100px" },
  "container": { "$value": "min(1280px, 100% - 48px)" },
  "shadow": {
    "karte": "inset 0 1px 0 rgba(255,255,255,.07), 0 28px 56px -32px rgba(0,0,0,.85), 0 2px 6px rgba(0,0,0,.25)",
    "kleineKarte": "inset 0 1px 0 rgba(255,255,255,.06), 0 12px 24px -16px rgba(0,0,0,.8)",
    "well": "inset 0 2px 10px rgba(0,0,0,.45), inset 0 0 0 1px rgba(255,255,255,.05)",
    "buttonPrimaer": "inset 0 1px 0 rgba(255,255,255,.6), 0 14px 34px -12px rgba(215,250,80,.6), 0 2px 0 rgba(0,0,0,.25)",
    "leuchten": "0 0 30px rgba(215,250,80,.9)",
    "dialog": "inset 0 1px 0 rgba(255,255,255,.08), 0 50px 100px -30px rgba(0,0,0,.95)"
  },
  "gradient": {
    "karte": "linear-gradient(180deg, #303634 0%, #262A28 100%)",
    "kleineKarte": "linear-gradient(180deg, #303634 0%, #292D2B 100%)",
    "buttonPrimaer": "linear-gradient(180deg, #EEFF9A 0%, #D7FA50 55%, #BFE83C 100%)",
    "balken": "linear-gradient(90deg, #78C331, #D7FA50)",
    "band": "radial-gradient(900px 320px at 12% 0%, rgba(215,250,80,.07), transparent 70%), radial-gradient(700px 300px at 92% 100%, rgba(111,227,207,.06), transparent 70%), linear-gradient(180deg, #2C312F, #262A28)",
    "seitengrund": "radial-gradient(1300px 640px at 88% -6%, rgba(215,250,80,.08), transparent 60%), radial-gradient(1000px 560px at 4% 38%, rgba(111,227,207,.055), transparent 62%), radial-gradient(900px 500px at 96% 72%, rgba(167,139,250,.06), transparent 62%), #242826",
    "spotlight": "radial-gradient(420px circle at var(--mx), var(--my), rgba(215,250,80,.13), transparent 60%)"
  },
  "motion": { "einblenden": "0.3–0.7s ease", "balken": "1.0–1.6s cubic-bezier(.2,.7,.2,1)", "laufband": "46s linear", "schimmer": "7s ease-in-out", "regel": "Bewegung = Zustand; prefers-reduced-motion schaltet alles ab" },
  "focus": { "ring": "2px solid #D7FA50", "offset": "2px", "logo": "Unterstreichung Lime, 6px Abstand" },
  "target": { "min": "44px" }
}
