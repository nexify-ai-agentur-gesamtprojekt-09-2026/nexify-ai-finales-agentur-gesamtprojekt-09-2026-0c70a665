{
  "$kommentar": "Pipeline-Definition (Anfrage bis Journal) · Soll · Entwurf 29.09.2026",
  "schritte": [
    { "id": "eingang",   "prueft": ["schluessel", "rate_limit", "budget_vor_anfrage"], "fehler": "429 | 402 mit verständlichem Text" },
    { "id": "regeln",    "prueft": ["hartsperren", "rolle", "mandant"], "fehler": "403" },
    { "id": "routing",   "startStufe": 0, "aufstieg": ["konfidenz<schwelle", "schema_fehler", "pruefungsrelevant"] },
    { "id": "ausfuehrung","agent": "nach Rolle", "rueckfrage": "nach Modus" },
    { "id": "kennzeichnung", "text": "KI-Antwort", "pflicht": true },
    { "id": "buchung",   "wann": "nach Antwort mit echten Token", "schluessel": "request_id", "doppelt": false },
    { "id": "journal",   "felder": ["zeit", "akteur", "aktion", "ziel", "ergebnis", "kosten_cent"], "unveraenderlich": true },
    { "id": "trace",     "ziel": "langfuse" }
  ],
  "abbruch": { "nie_mitten_in_antwort": true, "weich": "kritische Schlüssel laufen weiter", "hart": "optional je Kostenstelle" },
  "schwellen": { "warnung": [0.5, 0.8], "stopp": 1.0 },
  "preis": { "formel": "ek * (1 + aufschlag)", "aufschlag": null, "rundung": "intern 6 Nachkommastellen, Rechnung je Position auf Cent" }
}
